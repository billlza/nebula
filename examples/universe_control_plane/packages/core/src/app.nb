module app

fn service_name() -> String {
  return "universe-control-plane"
}

fn service_version() -> String {
  return "0.1.0"
}

fn default_port() -> Int {
  return 40520
}

fn default_base_url() -> String {
  return "http://127.0.0.1:40520"
}

fn default_state_file() -> String {
  return "./state/universe-services.log"
}

@test
fn test_universe_control_plane_defaults() -> Void {
  expect_eq(default_port(), 40520)
  assert(service_name() == "universe-control-plane", "service name drifted")
  assert(default_state_file() == "./state/universe-services.log", "state path drifted")
}
